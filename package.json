{
  "name": "obsidian-word-mode",
  "version": "1.2.0",
  "private": true,
  "description": "Obsidian plugin that lets you edit Markdown notes like a Word document while keeping the files clean Markdown.",
  "author": "NatLee",
  "license": "UNLICENSED",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NatLee/obsidian-word-mode.git"
  },
  "scripts": {
    "build": "node build.mjs",
    "build:prod": "node build.mjs --prod",
    "test": "node tests/basic.mjs && node tests/view/build-test.mjs && node tests/view/test.mjs",
    "test:vault": "node tests/vault-check.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "dependencies": {
    "markdown-it": "^15.0.3",
    "markdown-it-mark": "^4.0.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-dropcursor": "^1.8.4",
    "prosemirror-gapcursor": "^1.4.1",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.6.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-markdown": "^1.13.9",
    "prosemirror-model": "^1.25.13",
    "prosemirror-schema-list": "^1.6.0",
    "prosemirror-state": "^1.4.4",
    "prosemirror-tables": "^1.8.5",
    "prosemirror-transform": "^1.12.5",
    "prosemirror-view": "^1.42.9"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1"
  }
}
